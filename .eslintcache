":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/home/aloeffler/projects/personal-website/src/App.jsx",[],[],"/home/aloeffler/projects/personal-website/src/categories/Categories.js",[],[],"/home/aloeffler/projects/personal-website/src/categories/CategoriesKeys.jsx",[],[],"/home/aloeffler/projects/personal-website/src/common/MarkdownPathType.js",[],[],"/home/aloeffler/projects/personal-website/src/common/SubcategoryContentType.js",[],[],"/home/aloeffler/projects/personal-website/src/components/BackgroundLazyLoad.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/Breadcrumbs.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/If.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/Mobile.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/Spinner.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/audioPlayer/AudioPlayButton.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/audioPlayer/ProgressBar.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/categories/CategoryContent.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/categories/CategoryNavLinkItem.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/categories/CategoryNavLinks.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/categories/CategoryOption.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/categories/CategorySelector.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/codeblock/CategoryCodeBlockStyle.js",[],[],"/home/aloeffler/projects/personal-website/src/components/codeblock/CodeBlock.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/folder/Folder.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/linkBlock/LinkBlock.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/markdown/MarkdownDynamicContent.jsx",[],["518"],"/home/aloeffler/projects/personal-website/src/components/markdown/MarkdownSection.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/markdownimage/MarkdownImage.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/mermaid/Mermaid.jsx",["519","520","521","522"],[],"import React, { useEffect, useRef } from 'react';\nimport mermaid from 'mermaid';\n\nexport function Mermaid({ chart }) {\n    const containerRef = useRef(null);\n\n    useEffect(() => {\n        mermaid.initialize({ startOnLoad: false, fontFamily: 'pixel' });\n\n        const renderDiagram = async () => {\n            if (containerRef.current && chart) {\n                const content = chart[0];\n\n                if (typeof content === 'string' && content.trim()) {\n                    const { svg } = await mermaid.render(\n                        'mermaidDiagram',\n                        content.trim()\n                    );\n                    containerRef.current.innerHTML = svg;\n                }\n            }\n        };\n\n        renderDiagram();\n    }, [chart]);\n\n    return <div ref={containerRef} />;\n}\n","/home/aloeffler/projects/personal-website/src/components/pixel/PixelArtContent.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/pixel/PixelCharContent.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/pixel/PixelCharImage.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/subcategories/SubcategoryItem.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/swiper/BackgroundSwiper.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/timeline/CustomTimeline.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/timeline/CustomTimelineElement.jsx",[],[],"/home/aloeffler/projects/personal-website/src/components/timeline/TimelineMarkdownElementContent.jsx",["523"],[],"import PropTypes from 'prop-types';\nimport { useRequest } from '../../hooks/useRequest';\nimport { useEffect } from 'react';\nimport { useState } from 'react';\nimport emojiPlugin from 'remark-emoji';\nimport { MarkdownImage } from '../markdownimage/MarkdownImage';\nimport CodeBlock from '../codeblock/CodeBlock';\nimport rehypeRaw from 'rehype-raw';\nimport { MarkdownSection } from '../markdown/MarkdownSection';\nimport { useCategoryContext } from '../../hooks/useCategoryContext';\n\nexport function TimelineMarkdownElementContent({\n    link,\n    hideTimelineSpinnerOnFinishLoading,\n}) {\n    const { fetchUrl } = useRequest();\n    const [content, setContent] = useState();\n    const { category } = useCategoryContext();\n\n    useEffect(() => {\n        fetchUrl(link, {}, 'text')\n            .then((timelineRequestContent) => {\n                setContent(timelineRequestContent);\n            })\n            .finally(() => {\n                hideTimelineSpinnerOnFinishLoading();\n            });\n    }, []);\n\n    return (\n        <div>\n            <MarkdownSection\n                remarkPlugins={[emojiPlugin]}\n                rehypePlugins={[rehypeRaw]}\n                linkTarget={'_blank'}\n                $category={category}\n                components={{ code: CodeBlock, img: MarkdownImage }}\n            >\n                {content}\n            </MarkdownSection>\n        </div>\n    );\n}\n\nTimelineMarkdownElementContent.propTypes = {\n    link: PropTypes.string,\n    hideTimelineSpinnerOnFinishLoading: PropTypes.func,\n};\n","/home/aloeffler/projects/personal-website/src/contexts/CategoryContext.jsx",[],[],"/home/aloeffler/projects/personal-website/src/contexts/SidebarContext.jsx",[],[],"/home/aloeffler/projects/personal-website/src/elements/buttons/PixelButton.jsx",[],[],"/home/aloeffler/projects/personal-website/src/elements/sidebar/RectractButton.jsx",[],[],"/home/aloeffler/projects/personal-website/src/elements/sidebar/Sidebar.jsx",[],[],"/home/aloeffler/projects/personal-website/src/elements/sidebar/SidebarOption.jsx",[],[],"/home/aloeffler/projects/personal-website/src/hooks/useCategory.jsx",[],[],"/home/aloeffler/projects/personal-website/src/hooks/useCategoryContext.jsx",[],[],"/home/aloeffler/projects/personal-website/src/hooks/useCategoryDB.jsx",[],[],"/home/aloeffler/projects/personal-website/src/hooks/useMarkdownPath.jsx",[],[],"/home/aloeffler/projects/personal-website/src/hooks/useRequest.jsx",[],[],"/home/aloeffler/projects/personal-website/src/hooks/useSidebarContext.jsx",[],[],"/home/aloeffler/projects/personal-website/src/hooks/useStringHelper.jsx",[],[],"/home/aloeffler/projects/personal-website/src/icons/BackArrowIcon.jsx",["524"],[],"import PropTypes from 'prop-types';\n\nexport function BackArrowIcon({ fillColor, width = 32, height = 32 }) {\n    return (\n        <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            viewBox=\"0 -0.5 12 12\"\n            shapeRendering=\"crispEdges\"\n            fill={fillColor}\n            width={`${width}px`}\n            height={`${height}px`}\n        >\n            <path\n                stroke={fillColor}\n                d=\"M6 1h4M6 2h4M4 3h2M4 4h2M2 5h2M2 6h2M4 7h2M4 8h2M6 9h4M6 10h4\"\n            />\n        </svg>\n    );\n}\n\nBackArrowIcon.propTypes = {\n    fill: PropTypes.string,\n    width: PropTypes.number,\n    height: PropTypes.number,\n};\n","/home/aloeffler/projects/personal-website/src/icons/DynamicIcon.jsx",["525","526"],[],"import { HomeIcon } from './HomeIcon';\nimport { HttpIcon } from './HttpIcon';\nimport { WifiIcon } from './WifiIcon';\n\nexport function DynamicIcon({ iconFile, fillColor }) {\n    switch (iconFile) {\n        case 'WifiIcon.jsx':\n            return <WifiIcon fillColor={fillColor} />;\n        case 'HttpIcon.jsx':\n            return <HttpIcon fillColor={fillColor} />;\n        default:\n            return <HomeIcon fill={fillColor} />;\n    }\n}\n","/home/aloeffler/projects/personal-website/src/icons/FolderIcon.jsx",[],[],"/home/aloeffler/projects/personal-website/src/icons/HamburgerIcon.jsx",["527"],[],"import PropTypes from 'prop-types';\n\nexport function HamburgerIcon({ fillColor, width = 32, height = 32 }) {\n    return (\n        <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            viewBox=\"0 -0.5 12 12\"\n            shapeRendering=\"crispEdges\"\n            fill={fillColor}\n            width={`${width}px`}\n            height={`${height}px`}\n        >\n            <path\n                stroke={fillColor}\n                d=\"M1 2h10M1 3h10M1 5h10M1 6h10M1 8h10M1 9h10\"\n            />\n        </svg>\n    );\n}\n\nHamburgerIcon.propTypes = {\n    fill: PropTypes.string,\n    width: PropTypes.number,\n    height: PropTypes.number,\n};\n","/home/aloeffler/projects/personal-website/src/icons/HomeIcon.jsx",[],[],"/home/aloeffler/projects/personal-website/src/icons/HttpIcon.jsx",["528"],[],"import PropTypes from 'prop-types';\n\nexport function HttpIcon({ fillColor }) {\n    return (\n        <svg\n            xmlns=\"http://www.w3.org/2000/svg\"\n            viewBox=\"0 -0.5 12 12\"\n            shapeRendering=\"crispEdges\"\n            width=\"24\"\n            heigth=\"24\"\n        >\n            <path\n                stroke={fillColor}\n                d=\"M6 2h1M9 2h1M6 3h1M9 3h1M2 4h1M5 4h1M8 4h1M5 5h1M8 5h1M2 6h1M5 6h1M8 6h1M4 7h1M7 7h1M4 8h1M7 8h1\"\n            />\n        </svg>\n    );\n}\n\nHttpIcon.propTypes = {\n    fillColor: PropTypes.string,\n};\n","/home/aloeffler/projects/personal-website/src/icons/MusicIcon.jsx",["529"],[],"import PropTypes from 'prop-types';\n\nexport function MusicIcon({ fill }) {\n    return (\n        <svg\n            width=\"64\"\n            height=\"64\"\n            viewBox=\"0 0 24 24\"\n            fill={fill}\n            xmlns=\"http://www.w3.org/2000/svg\"\n        >\n            <path\n                fillRule=\"evenodd\"\n                clipRule=\"evenodd\"\n                d=\"M8 4H20V20H12V12H18V8H10V20H2V12H8V4ZM8 14H4V18H8V14ZM18 14H14V18H18V14Z\"\n           